# Required - Nano Banana Flash (Gemini 3.1 Flash Image) renders
GOOGLE_API_KEY=

# Required for the maps, address search and nearby places. A Mapbox PUBLIC token (pk.…);
# restrict it in Mapbox to localhost and your Vercel domains - the browser sees it.
MAPBOX_TOKEN=
# Set to 1 once the Mapbox account has permanent geocoding (needed to store addresses
# for share links under Mapbox's terms)
# MAPBOX_PERMANENT_GEOCODING=1

# Listing photos from Zillow and Redfin (ScraperAPI account key)
SCRAPERAPI_KEY=

# Storage for pulled listing photos, uploads and renders (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Neon Postgres - email capture log and share links
DATABASE_URL=

# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=2K
# MAX_LISTING_PHOTOS=24
