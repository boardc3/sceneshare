{
  "name": "sceneshare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/demo-media.mjs && vite",
    "build": "node scripts/demo-media.mjs && vite build",
