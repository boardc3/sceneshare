    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "3.10.6",
    "mapbox-gl": "3.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@electric-sql/pglite": "0.3.16",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "better-auth": "1.7.17",
